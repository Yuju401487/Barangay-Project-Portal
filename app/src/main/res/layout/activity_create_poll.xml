<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sakura_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Poll"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#EC407A"/>

        <EditText
            android:id="@+id/etQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Poll Question"
            android:textColor="#000000"
            android:textColorHint="#808080"/>

        <EditText
            android:id="@+id/etOption1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Option 1"
            android:textColor="#000000"
            android:textColorHint="#808080"/>

        <EditText
            android:id="@+id/etOption2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Option 2"
            android:textColor="#000000"
            android:textColorHint="#808080"/>

        <EditText
            android:id="@+id/etOption3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Option 3"
            android:textColor="#000000"
            android:textColorHint="#808080"/>

        <Button
            android:id="@+id/btnCreatePoll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Poll"
            android:textColor="#FFFFFF"
            android:backgroundTint="#EC407A"
            android:layout_marginTop="20dp"/>

    </LinearLayout>

</ScrollView>