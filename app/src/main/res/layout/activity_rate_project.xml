<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sakura_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvProjectTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Project Title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#EC407A"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Project Rating"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#4A4A4A"
            android:layout_marginBottom="8dp" />

        <RatingBar
            android:id="@+id/ratingBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="1"
            android:progressTint="#EC407A"
            android:secondaryProgressTint="#F8BBD0"
            android:progressBackgroundTint="#FCE4EC"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Feedback"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#4A4A4A"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etFeedback"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:hint="Write your feedback here..."
            android:gravity="top"
            android:padding="12dp"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:backgroundTint="#EC407A" />

        <Button
            android:id="@+id/btnSubmitRating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="SUBMIT RATING"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#EC407A" />

    </LinearLayout>

</ScrollView>