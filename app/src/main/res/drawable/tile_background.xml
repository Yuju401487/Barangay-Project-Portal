<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Shadow -->
    <item
        android:left="12dp"
        android:top="12dp">

        <shape android:shape="rectangle">
            <solid android:color="#25000000"/>
        </shape>

    </item>

    <!-- Back paper -->
    <item
        android:left="8dp"
        android:top="8dp">

        <shape android:shape="rectangle">
            <solid android:color="#EC407A"/>
        </shape>

    </item>

    <!-- Front paper -->
    <item
        android:right="8dp"
        android:bottom="8dp">

        <shape android:shape="rectangle">

            <gradient
                android:startColor="#EC407A"
                android:endColor="#EC407A"
                android:angle="270" />

            <stroke
                android:width="1dp"
                android:color="#EC407A"/>

        </shape>

    </item>

    <!-- Tiny Sakura Accent -->
    <item
        android:right="8dp"
        android:bottom="8dp">

        <layer-list>

            <item>
                <shape android:shape="rectangle">
                    <size android:height="5dp"/>
                    <solid android:color="#FB9DC6" />
                </shape>
            </item>

        </layer-list>

    </item>

</layer-list>